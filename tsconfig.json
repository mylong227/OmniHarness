{
  "compilerOptions": {
    // `target` 只决定 **emit 的语法下界**；类型由 `lib` 决定，两者已解耦。
    //
    // 为什么是 ES2023 而不是 ES2024（2026-10-18）：esbuild（Vite/Vitest 的转译器）
    // 不认识 `ES2024` 这个字符串，会对**每一个**被转译的测试文件打
    // `Unrecognized target environment "ES2024"` —— 实测几百行警告把真正的失败信息淹掉了。
    // ES2024 相对 ES2023 的新增（`Object.groupBy` / `Promise.withResolvers` /
    // `Array.fromAsync`）都是**库特性而非语法**，全由 `lib` 提供，与 `target` 无关；
    // 故 target 降到 ES2023 不损失任何可用 API，`lib` 仍保留 ES2024。
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 导入约定（2026-10-17 起）：**相对导入一律写真实源文件后缀 `.ts`**（前后端统一，
    // 与 Vite 前端同构）。emit 时由该旗标把 `.ts`/`.tsx` 重写回 `.js`，dist 产物仍是
    // 标准 ESM —— 这正是 TS 5.7 引入 `rewriteRelativeImportExtensions` 的目的：
    // 「源码写 .ts 后缀，产物写 .js 后缀」两件事同时成立，不再需要 `.js` 后缀约定。
    // 指向真实 `.js`（如编译产物、node_modules）的导入不受影响，按字面保留。
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"]
}
