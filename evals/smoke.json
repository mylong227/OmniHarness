{
  "name": "smoke-external",
  "description": "与内置 smoke 等价的外部 JSON 样例（演示 --suite 加载）：read→shell→write 工具链路 + 纯文本应答",
  "tasks": [
    {
      "id": "read-process-write",
      "description": "read_file → shell → write_file 三步工具链路",
      "prompt": "读取 input.txt，处理后把结果写入 output.txt",
      "seedFiles": { "input.txt": "line1\nline2\nline3\n" },
      "script": [
        {
          "toolCalls": [{ "id": "c1", "name": "read_file", "arguments": { "path": "input.txt" } }]
        },
        {
          "toolCalls": [
            { "id": "c2", "name": "shell", "arguments": { "command": "echo PROCESSED-OK-12345" } }
          ]
        },
        {
          "toolCalls": [
            {
              "id": "c3",
              "name": "write_file",
              "arguments": { "path": "output.txt", "content": "PROCESSED-OK-12345" }
            }
          ]
        },
        { "text": "处理完成，结果 PROCESSED-OK-12345 已写入 output.txt" }
      ],
      "expect": {
        "tools": ["read_file", "shell", "write_file"],
        "text": "PROCESSED-OK-12345",
        "files": { "output.txt": "PROCESSED-OK-12345" }
      }
    },
    {
      "id": "plain-greeting",
      "description": "无工具调用的纯文本应答",
      "prompt": "用一句话打招呼",
      "script": [],
      "finalText": "你好，我是 OmniHarness。",
      "expect": { "text": "你好" }
    },
    {
      "id": "read-only-inspect",
      "description": "read_file 单工具读取并复述",
      "prompt": "读取 notes.txt 并原样复述其内容",
      "seedFiles": { "notes.txt": "TODO: 完成第五章校对\nTODO: 提交周报\n" },
      "script": [
        {
          "toolCalls": [{ "id": "c1", "name": "read_file", "arguments": { "path": "notes.txt" } }]
        },
        { "text": "notes.txt 内容如下：\nTODO: 完成第五章校对\nTODO: 提交周报" }
      ],
      "expect": {
        "tools": ["read_file"],
        "text": "TODO: 完成第五章校对"
      }
    },
    {
      "id": "write-then-read",
      "description": "write_file → read_file 回读校验",
      "prompt": "把 'HELLO-OMNI' 写入 flag.txt 再读回来确认",
      "script": [
        {
          "toolCalls": [
            {
              "id": "w1",
              "name": "write_file",
              "arguments": { "path": "flag.txt", "content": "HELLO-OMNI" }
            }
          ]
        },
        { "toolCalls": [{ "id": "r1", "name": "read_file", "arguments": { "path": "flag.txt" } }] },
        { "text": "已写入并读回确认：HELLO-OMNI" }
      ],
      "expect": {
        "tools": ["write_file", "read_file"],
        "text": "HELLO-OMNI",
        "files": { "flag.txt": "HELLO-OMNI" }
      }
    },
    {
      "id": "transform-with-shell",
      "description": "read_file → shell 转换 → write_file",
      "prompt": "读取 data.txt 把每行转为大写后写入 upper.txt",
      "seedFiles": { "data.txt": "alpha\nbeta\ngamma\n" },
      "script": [
        { "toolCalls": [{ "id": "c1", "name": "read_file", "arguments": { "path": "data.txt" } }] },
        {
          "toolCalls": [
            { "id": "c2", "name": "shell", "arguments": { "command": "echo UPPER-OK-7788" } }
          ]
        },
        {
          "toolCalls": [
            {
              "id": "c3",
              "name": "write_file",
              "arguments": { "path": "upper.txt", "content": "UPPER-OK-7788" }
            }
          ]
        },
        { "text": "已转换并写入 upper.txt" }
      ],
      "expect": {
        "tools": ["read_file", "shell", "write_file"],
        "text": "UPPER-OK-7788",
        "files": { "upper.txt": "UPPER-OK-7788" }
      }
    }
  ]
}
