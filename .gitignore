# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.wheelhouse*/
.venv/
venv/

# Credentials and machine-local Codex configuration
.env
.env.*
config.yaml
config.local.yaml
*.pem
*.key
auth.json
.codex/

# Runtime outputs and mutable memory
runs/
outputs/
results/
task_contract.json
proposal_audit.jsonl
resources/symbolic_policy/.omniharness_state.json
resources/symbolic_policy/.omniharness.lock
*.tmp
# 原生别名桥单测在 cwd 下写入的探针文件（Windows 上 unlink 可能被内核句柄占用而清理失败）。
.omni-alias-*

# Local third-party benchmark material
# These files remain available to local experiments but are intentionally kept
# out of Git until their individual redistribution terms are satisfied.
bench data/
eval-data/
resources/source_image_pool_comfybench/images/
resources/source_image_pool_gpt/images/
*.baiduyun.uploading.cfg

# Node / Rust build outputs and dependencies (never commit)
node_modules/
target/
**/target/
*.node

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# OmniHarness runtime state and regenerable caches (machine-local, never commit)
.omni/
.omni-*/
.omni_diag/
.omniharness/
.omniharness-kv.json
omniharness.db

# Machine-local runtime config that may hold credentials.
# Keep omniharness.json.example tracked as the distributable template.
omniharness.json

# Local logs and ad-hoc diagnostics
*.log

# Terminal-Bench 默认报告落点（`--report` 缺省值）；跑一次就在仓库根留一个运行产物。
# 需要入库的是**筛选过的**证据（见 benchmark/terminalbench-gold-20.json 等，用显式 --report 指定名字）。
/terminalbench.report.json

# Pre-operation backups of the .git directory
.git.bak.*
