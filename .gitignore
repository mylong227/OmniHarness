# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.wheelhouse*/
.venv/
venv/
# 真机截图存档（virtualProbe 输出，存盘留档但不进仓库）
web/archive/*.png

# Credentials and machine-local Codex configuration
.env
.env.*
config.yaml
config.local.yaml
*.pem
*.key
auth.json
.codex/

# Runtime outputs and mutable memory
runs/
outputs/
results/
task_contract.json
proposal_audit.jsonl
resources/symbolic_policy/.omniharness_state.json
resources/symbolic_policy/.omniharness.lock
*.tmp
# 原生别名桥单测在 cwd 下写入的探针文件（Windows 上 unlink 可能被内核句柄占用而清理失败）。
.omni-alias-*

# Local third-party benchmark material
# These files remain available to local experiments but are intentionally kept
# out of Git until their individual redistribution terms are satisfied.
# （`eval-data/` 一行已于 2026-10-03 删除：该目录随跑分/评测子系统一并移除，不再生成。
#   ESLint 仍保留同名排除作为防御，见 eslint.config.mjs。）
bench data/
resources/source_image_pool_comfybench/images/
resources/source_image_pool_gpt/images/
*.baiduyun.uploading.cfg

# Node / Rust build outputs and dependencies (never commit)
node_modules/
target/
**/target/
*.node

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# OmniHarness runtime state and regenerable caches (machine-local, never commit)
.omni/
.omni-*/
.omni_diag/
.omniharness/
.omniharness-kv.json
omniharness.db

# Machine-local runtime config that may hold credentials.
# Keep omniharness.json.example tracked as the distributable template.
omniharness.json

# Local logs and ad-hoc diagnostics
*.log

# Terminal-Bench 默认报告落点（`--report` 缺省值）——跑分系统已于 2026-10-03 整体删除，
# 该报告不再生成。规则保留为防御：万一旧工具链残留一个报告文件，不脏工作树。
/terminalbench.report.json

# Pre-operation backups of the .git directory
.git.bak.*

# 第三方资源语料：3414 文件 / 20.8 MB、零代码消费者（2026-09-22 审计实测）——迁出仓库，
# 需要时按 THIRD_PARTY_ASSETS.md 的说明单独获取。
resources/comfyui_node_reference/

# 第三方资源总管（third-party/）：模型权重与 Python 运行时 venv 不入库（机器相关 + 大体积），
# 仅开源源码 + 许可随仓库跟踪；获取/重建方式见 THIRD_PARTY_ASSETS.md。
third-party/laya-model/
third-party/laya-venv/

# 本机外部产物（非本仓库生成，2026-09-23 发现于工作区根）：Chrome 配置/注册表备份，勿入库。
chrome-hijack-backup/


# 发布产物（走 GitHub Release 分发，不入库）
*.tgz


# 临时探针/提交草稿目录（bad.js 等故意写坏的探针会让 lint 门禁误红）
.tmpcheck/

# AI 助手会话工作日志（机器本地记忆，不入库）
.workbuddy/

# 第三方运行缓存（按功能收编进 third-party/，可随时重建，不入库；见 THIRD_PARTY_ASSETS.md）
third-party/model-cache/
third-party/vec-cache/
third-party/swebench-repos/

# 上下文效率基准的临时编译产物（run.sh bash+tsc 管线写入）
.xeval/
