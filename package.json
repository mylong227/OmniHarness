{
  "name": "omniharness",
  "version": "0.1.0",
  "description": "OmniHarness —— 通用 Agent Harness：TypeScript（CLI / Web 前端 / 编排）+ Rust（原生内核）",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./beta": {
      "types": "./dist/src/indexBeta.d.ts",
      "default": "./dist/src/indexBeta.js"
    }
  },
  "files": [
    "dist/src",
    "defaults",
    "web",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "omniharness.json.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharness/omniharness.git"
  },
  "homepage": "https://github.com/omniharness/omniharness#readme",
  "bugs": {
    "url": "https://github.com/omniharness/omniharness/issues"
  },
  "keywords": [
    "agent",
    "harness",
    "ai",
    "llm",
    "codex",
    "cli",
    "mcp"
  ],
  "bin": {
    "omniharness": "dist/src/cli/exec.js"
  },
  "scripts": {
    "clean": "node scripts/cleanDist.mjs dist web/dist",
    "build": "node scripts/cleanDist.mjs dist && tsc",
    "web:build": "node scripts/cleanDist.mjs web/dist && tsc -p web/tsconfig.json",
    "web:watch": "tsc -p web/tsconfig.json --watch",
    "web:test": "npm run web:build && node --test --test-timeout=30000 \"web/test/**/*.test.mjs\"",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm run web:build",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "check:doc-links": "node scripts/docLinkCheck.mjs",
    "check:node": "node scripts/checkNodeEngine.mjs",
    "audit:maturity": "node scripts/auditStandards.mjs --maturity",
    "audit:standard": "node scripts/auditStandards.mjs",
    "audit:standard:delta": "node scripts/auditStandards.mjs --delta",
    "audit:metrics": "node scripts/auditStandards.mjs --p02",
    "audit:config-wiring": "node scripts/auditConfigWiring.mjs",
    "arch:gate": "node scripts/architectureGate.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:check": "node scripts/coverageGate.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "api:check": "node scripts/apiStability.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "coverage": "npm run build && node --test --test-timeout=120000 --experimental-test-coverage --test-coverage-include=\"dist/src/**/*.js\" \"dist/tests/unit/*.test.js\"",
    "test": "npm run build && node --test --test-timeout=120000 \"dist/tests/unit/*.test.js\"",
    "test:integration": "npm run build && node --test --test-timeout=180000 \"dist/tests/integration/*.test.js\"",
    "smoke": "npm run build && node dist/tests/smoke.js",
    "stress": "npm run build && node --expose-gc dist/tests/stress.js",
    "ptc-stress": "npm run build && node dist/tests/ptcStress.js",
    "bench": "npm run build && node dist/tests/bench/compactionBench.js",
    "bench:native": "npm run native:build && npm run build && node dist/tests/bench/nativeVsJs.bench.js",
    "bench:tokens": "npm run native:build && npm run build && node dist/tests/bench/tokenEstNative.bench.js",
    "bench:agent": "npm run native:build && npm run build && node dist/tests/bench/agentTask.bench.js",
    "bench:compete": "node benchmark/compete_benchmark.mjs",
    "bench:terminalbench": "npm run build && node dist/src/benchmark/terminalbench/terminalBenchCli.js",
    "metrics:injection": "npm run build && node evals/injection-metric.mjs",
    "metrics:injection:calibrate": "npm run build && node evals/injection-calibrate.mjs",
    "metrics:attribution": "npm run build && node evals/token-attribution.mjs",
    "metrics:tool-exposure": "npm run build && node evals/tool-exposure-ab.mjs",
    "selfcheck": "npm run build && node benchmark/selfcheck.mjs",
    "eval:capability": "npm run build && node benchmark/capability_swebench.mjs",
    "eval:passk": "node --test dist/tests/unit/passK.test.js dist/tests/unit/passKCI.test.js",
    "eval:swebench": "node benchmark/capability_swebench.mjs",
    "eval:swebench:verified": "npm run build && node benchmark/capability_swebench.mjs --verified",
    "eval:live": "node evals/live/bench.mjs",
    "eval:list": "node scripts/runEval.mjs --list",
    "eval:run": "node scripts/runEval.mjs",
    "eval:a2a-loopback": "node scripts/runEval.mjs a2a-loopback",
    "eval:bm25-tune": "node scripts/runEval.mjs bm25-tune",
    "eval:budget-recall-tradeoff": "node scripts/runEval.mjs budget-recall-tradeoff",
    "eval:cache-probe": "node scripts/runEval.mjs cache-probe",
    "eval:compaction-wiring": "node scripts/runEval.mjs compaction-wiring",
    "eval:diag-spectrum": "node scripts/runEval.mjs diag-spectrum",
    "eval:e2e-native-gitee-smoke": "node scripts/runEval.mjs e2e-native-gitee-smoke",
    "eval:headroom-analysis": "node scripts/runEval.mjs headroom-analysis",
    "eval:injection-calibrate": "node scripts/runEval.mjs injection-calibrate",
    "eval:injection-metric": "node scripts/runEval.mjs injection-metric",
    "eval:layered-fusion-ab": "node scripts/runEval.mjs layered-fusion-ab",
    "eval:layered-recall-ab": "node scripts/runEval.mjs layered-recall-ab",
    "eval:military-chain-ab": "node scripts/runEval.mjs military-chain-ab",
    "eval:military-chain2-ab": "node scripts/runEval.mjs military-chain2-ab",
    "eval:military-pareto": "node scripts/runEval.mjs military-pareto",
    "eval:military-payload-ab": "node scripts/runEval.mjs military-payload-ab",
    "eval:military-verdict": "node scripts/runEval.mjs military-verdict",
    "eval:pool-depth-probe": "node scripts/runEval.mjs pool-depth-probe",
    "eval:prefix-stability": "node scripts/runEval.mjs prefix-stability",
    "eval:production-defaults-check": "node scripts/runEval.mjs production-defaults-check",
    "eval:rank-veto-retro": "node scripts/runEval.mjs rank-veto-retro",
    "eval:recall-codebase-real": "node scripts/runEval.mjs recall-codebase-real",
    "eval:recall-compare": "node scripts/runEval.mjs recall-compare",
    "eval:recall-compare-real": "node scripts/runEval.mjs recall-compare-real",
    "eval:recall-precision": "node scripts/runEval.mjs recall-precision",
    "eval:recall-query-audit": "node scripts/runEval.mjs recall-query-audit",
    "eval:rerank-ab": "node scripts/runEval.mjs rerank-ab",
    "eval:semantic-bridge-ab": "node scripts/runEval.mjs semantic-bridge-ab",
    "eval:semantic-recall-ab": "node scripts/runEval.mjs semantic-recall-ab",
    "eval:semantic-smoke": "node scripts/runEval.mjs semantic-smoke",
    "eval:spider-density-sweep": "node scripts/runEval.mjs spider-density-sweep",
    "eval:spider-final-ab": "node scripts/runEval.mjs spider-final-ab",
    "eval:spider-pool-ab": "node scripts/runEval.mjs spider-pool-ab",
    "eval:spider-quota-ab": "node scripts/runEval.mjs spider-quota-ab",
    "eval:spider-reach-probe": "node scripts/runEval.mjs spider-reach-probe",
    "eval:spider-termweb-ab": "node scripts/runEval.mjs spider-termweb-ab",
    "eval:token-attribution": "node scripts/runEval.mjs token-attribution",
    "eval:tool-exposure-ab": "node scripts/runEval.mjs tool-exposure-ab",
    "eval:ci": "npm run build && node --test dist/tests/unit/passK.test.js dist/tests/unit/passKCI.test.js && node benchmark/capability_swebench.mjs && node evals/live/bench.mjs --swebench --repeat 5 --min-pass-k 3,0.9 --min-pass-k-ci 3,0.9",
    "eval:veto": "npm run build && node evals/rank-veto-retro.mjs --gate",
    "eval:compaction": "npm run build && node evals/compaction-wiring.mjs",
    "eval:rerank": "npm run build && node evals/rerank-ab.mjs --gate",
    "eval:prefix": "npm run build && node evals/prefix-stability.mjs",
    "longrun:backfill": "npm run build && node benchmark/longrun_backfill.mjs",
    "longrun:run": "npm run build && node benchmark/longrun_run.mjs",
    "longrun:tighten": "npm run build && node benchmark/tighten.mjs",
    "longrun:prod": "npm run build && node benchmark/longrun_prod_demo.mjs",
    "longrun:prod:real": "node benchmark/longrun_prod_real.mjs",
    "longrun:tighten:prod": "npm run build && node benchmark/tighten.mjs --live runtime-telemetry.prod.log",
    "exec": "npm run build && node dist/src/cli/exec.js",
    "test:wasm": "node tests/wasmE2e.mjs",
    "rust:test": "cargo test --workspace",
    "wasm:build": "cargo build --target wasm32-unknown-unknown -p omni-wasm",
    "wasm:build:release": "cargo build --release --target wasm32-unknown-unknown -p omni-wasm",
    "wasm:test": "cargo build --release --target wasm32-unknown-unknown -p omni-wasm && node tests/wasmE2e.mjs",
    "native:build": "node scripts/nativeBuild.mjs",
    "native:test": "npm run native:build && node tests/napiE2e.cjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
