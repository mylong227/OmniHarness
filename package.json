{
  "name": "@mylong227/omniharness",
  "version": "0.2.0",
  "description": "OmniHarness —— 通用 Agent Harness：TypeScript（CLI / Web 前端 / 编排）+ Rust（原生内核）",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./beta": {
      "types": "./dist/src/indexBeta.d.ts",
      "default": "./dist/src/indexBeta.js"
    }
  },
  "files": [
    "dist/src",
    "defaults",
    "web",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "omniharness.json.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylong227/OmniHarness.git"
  },
  "homepage": "https://github.com/mylong227/OmniHarness#readme",
  "bugs": {
    "url": "https://github.com/mylong227/OmniHarness/issues"
  },
  "keywords": [
    "agent",
    "harness",
    "ai",
    "llm",
    "codex",
    "cli",
    "mcp"
  ],
  "bin": {
    "omniharness": "dist/src/cli/exec.js"
  },
  "scripts": {
    "clean": "node scripts/cleanDist.mjs dist web/dist",
    "build": "node scripts/cleanDist.mjs dist && tsc && node scripts/copyAssets.mjs",
    "web:build": "node scripts/cleanDist.mjs web/dist && tsc -p web/tsconfig.json",
    "web:watch": "tsc -p web/tsconfig.json --watch",
    "web:test": "npm run web:build && node --test --test-timeout=60000 \"web/test/**/*.test.mjs\"",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm run web:build",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "check:doc-links": "node scripts/docLinkCheck.mjs",
    "check:node": "node scripts/checkNodeEngine.mjs",
    "check:secrets": "node scripts/checkSecrets.mjs",
    "audit:maturity": "node scripts/auditStandards.mjs --maturity",
    "audit:standard": "node scripts/auditStandards.mjs",
    "audit:standard:delta": "node scripts/auditStandards.mjs --delta",
    "audit:metrics": "node scripts/auditStandards.mjs --p02",
    "audit:config-wiring": "node scripts/auditConfigWiring.mjs",
    "arch:gate": "node scripts/architectureGate.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:check": "node scripts/coverageGate.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "api:check": "node scripts/apiStability.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "coverage": "npm run build && node --test --test-timeout=120000 --experimental-test-coverage --test-coverage-include=\"dist/src/**/*.js\" \"dist/tests/unit/*.test.js\"",
    "test": "npm run build && node --test --test-timeout=120000 \"dist/tests/unit/*.test.js\"",
    "test:integration": "npm run build && node --test --test-timeout=180000 \"dist/tests/integration/*.test.js\"",
    "smoke": "npm run build && node dist/tests/smoke.js",
    "stress": "npm run build && node --expose-gc dist/tests/stress.js",
    "ptc-stress": "npm run build && node dist/tests/ptcStress.js",
    "exec": "npm run build && node dist/src/cli/exec.js",
    "test:wasm": "node tests/wasmE2e.mjs",
    "rust:test": "cargo test --workspace",
    "wasm:build": "cargo build --target wasm32-unknown-unknown -p omni-wasm",
    "wasm:build:release": "cargo build --release --target wasm32-unknown-unknown -p omni-wasm",
    "wasm:test": "cargo build --release --target wasm32-unknown-unknown -p omni-wasm && node tests/wasmE2e.mjs",
    "native:build": "node scripts/nativeBuild.mjs",
    "native:test": "npm run native:build && node tests/napiE2e.cjs",
    "audit:top-level-fn": "node scripts/auditTopLevelFunctions.mjs",
    "lint:typed": "node scripts/runGates.mjs --tier=typed",
    "gate:typed": "node scripts/runGates.mjs --tier=typed",
    "gate:budget": "node scripts/gateBudget.mjs",
    "probe:recall": "node tools/probes/recallHitrate.mjs",
    "probe:exposure": "node tools/probes/toolExposureBudget.mjs",
    "probe:rerank-ab": "node tools/probes/rerankDiscriminatorAb.mjs",
    "smoke:real": "node scripts/realRunSmoke.mjs --phase=all",
    "smoke:model": "node scripts/realModelComplexTest.mjs",
    "smoke:ui": "node scripts/realUiScenario.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "croner": "10.0.1",
    "jose": "6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
