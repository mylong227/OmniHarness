{
  "name": "@mylong227/omniharness",
  "version": "0.2.0",
  "description": "OmniHarness —— 通用 Agent Harness：TypeScript（CLI / Web 前端 / 编排）+ Rust（原生内核）",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./beta": {
      "types": "./dist/src/indexBeta.d.ts",
      "default": "./dist/src/indexBeta.js"
    }
  },
  "files": [
    "dist/src",
    "defaults",
    "web/dist",
    "web/index.html",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "omniharness.json.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylong227/OmniHarness.git"
  },
  "homepage": "https://github.com/mylong227/OmniHarness#readme",
  "bugs": {
    "url": "https://github.com/mylong227/OmniHarness/issues"
  },
  "keywords": [
    "agent",
    "harness",
    "ai",
    "llm",
    "cli",
    "mcp"
  ],
  "bin": {
    "omniharness": "dist/src/cli/exec.js"
  },
  "scripts": {
    "start": "node scripts/startAll.mjs",
    "dev": "node scripts/devAll.mjs",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:start": "npm --prefix desktop start",
    "desktop:test": "npm --prefix desktop test",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:dist": "npm --prefix desktop run dist",
    "clean": "node scripts/cleanDist.mjs dist web/dist",
    "build": "node scripts/buildDist.mjs",
    "web:build": "vite build",
    "web:dev": "vite",
    "web:watch": "vite build --watch",
    "web:budget": "node scripts/webBundleBudget.mjs",
    "perf:context": "node scripts/profileContextHotpath.mjs",
    "perf:gate": "node scripts/perfGate.mjs",
    "web:test": "npm run web:build && npm run test:web",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm run web:build",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "node scripts/check.mjs",
    "check:doc-links": "node scripts/docLinkCheck.mjs",
    "check:node": "node scripts/checkNodeEngine.mjs",
    "check:secrets": "node scripts/checkSecrets.mjs",
    "audit:maturity": "node scripts/auditStandards.mjs --maturity",
    "audit:standard": "node scripts/auditStandards.mjs",
    "audit:standard:delta": "node scripts/auditStandards.mjs --delta",
    "audit:metrics": "node scripts/auditStandards.mjs --p02",
    "audit:config-wiring": "node scripts/auditConfigWiring.mjs",
    "audit:independence": "node scripts/independenceAudit.mjs",
    "arch:gate": "node scripts/architectureGate.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:check": "node scripts/coverageGate.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "api:check": "node scripts/apiStability.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "coverage": "node scripts/workspaceLease.mjs --name=workspace -- vitest run --project node tests/unit/ --coverage.enabled",
    "test": "npm run build && npm run test:fast && npm run test:web",
    "test:fast": "node scripts/workspaceLease.mjs --name=workspace -- vitest run --project node tests/unit/",
    "test:web": "node scripts/workspaceLease.mjs --name=workspace -- vitest run --project web",
    "test:slow": "npm run test:integration && npm run test:web",
    "test:integration": "npm run build && npm run web:build && node scripts/workspaceLease.mjs --name=workspace -- vitest run --project node tests/integration/",
    "smoke": "npm run build && node dist/tests/smoke.js",
    "stress": "npm run build && node --expose-gc dist/tests/stress.js",
    "ptc-stress": "npm run build && node dist/tests/ptcStress.js",
    "exec": "npm run build && node dist/src/cli/exec.js",
    "test:wasm": "node tests/wasmE2e.mjs",
    "rust:test": "node scripts/cargo.mjs test --workspace",
    "rust:fmt": "node scripts/cargo.mjs fmt --all",
    "rust:clippy": "node scripts/cargo.mjs clippy --workspace --all-targets -- -D warnings",
    "wasm:build": "node scripts/cargo.mjs build --target wasm32-unknown-unknown -p omni-wasm",
    "wasm:build:release": "node scripts/cargo.mjs build --release --target wasm32-unknown-unknown -p omni-wasm",
    "wasm:test": "node scripts/cargo.mjs build --release --target wasm32-unknown-unknown -p omni-wasm && node tests/wasmE2e.mjs",
    "native:build": "node scripts/nativeBuild.mjs",
    "native:test": "npm run native:build && node tests/napiE2e.cjs",
    "audit:top-level-fn": "node scripts/auditTopLevelFunctions.mjs",
    "lint:typed": "node scripts/runGates.mjs --tier=typed",
    "gate:typed": "node scripts/runGates.mjs --tier=typed",
    "gate:budget": "node scripts/gateBudget.mjs",
    "probe:recall": "node tools/probes/recallHitrate.mjs",
    "probe:recall:hybrid": "node tools/probes/recallHitrate.mjs --lens=hybrid --strict",
    "probe:recall:both": "node tools/probes/recallHitrate.mjs --lens=both --strict",
    "eval:harness": "node tools/eval/harnessAb.mjs",
    "eval:long": "node tools/eval/longTasks.mjs",
    "trace:patch": "node tools/eval/traceToPatch.mjs",
    "eval:longmem": "node tools/eval/longMemEval.mjs",
    "skill:sign": "node tools/skills/sign.mjs",
    "skill:verify": "node tools/skills/verify.mjs",
    "test:determinism": "node scripts/testDeterminism.mjs",
    "mcp:conformance": "vitest run --project node tests/unit/mcpAuth.test.ts tests/unit/mcpMrtr.test.ts tests/unit/mcpStateless.test.ts tests/unit/sdkMcpConnector.test.ts tests/unit/mcpServerV2.test.ts tests/unit/mcpV2Client.test.ts tests/unit/mcpSecurityV2.test.ts tests/unit/mcpServeWiringV2.test.ts",
    "tmp:sweep": "node tools/hygiene/tmpSweep.mjs",
    "checkpoint:sweep": "node scripts/checkpointSweep.mjs",
    "probe:memory-task": "node tools/probes/memoryTaskLift.mjs",
    "probe:exposure": "node tools/probes/toolExposureBudget.mjs",
    "probe:rerank-ab": "node tools/probes/rerankDiscriminatorAb.mjs",
    "probe:laya": "node tools/probes/layaVerdictCalibration.mjs",
    "telemetry:sessions": "node tools/sessionTelemetry.mjs",
    "migrate:attachments": "node scripts/migrateSessionAttachments.mjs",
    "prm:train": "node scripts/trainProcessReward.mjs",
    "smoke:real": "node scripts/realRunSmoke.mjs --phase=all",
    "smoke:model": "node scripts/realModelComplexTest.mjs",
    "smoke:ui": "node scripts/realUiScenario.mjs",
    "test:frontend": "npm run web:build && vitest run --project web"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "croner": "10.0.1",
    "highlight.js": "^11.12.0",
    "jose": "6.2.12",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.3",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sirv": "^3.0.2",
    "zod": "^4.6.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.4",
    "unpdf": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
