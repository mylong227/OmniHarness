#!/bin/sh
# OmniHarness pre-commit 钩子——**薄包装**：判定逻辑单点在 `scripts/runGates.mjs`（node 实现）。
#
# 为什么不在本文件里写门禁（2026-09-25 事故后改写）：
#   ① 受限环境下 git 只能经 `sh.exe` 起钩子，而沙箱会拒绝 cygwin 共享内存创建
#      （`sh.exe: *** fatal error - CreateFileMapping ..., Win32 error 5`）⇒ 钩子整段不可执行、
#      提交**静默绕过全部门禁**；node 实现可用 `node scripts/runGates.mjs --hook` 在任何环境手工跑齐同一套判定。
#   ② 门禁清单只留一份，避免钩子 / CI / 人工三处漂移（历史上已漂过：钩子用 `npm run`、CI 用 `node`；
#      而本机 `npm.ps1` 实测损坏，指向 npm 的写法在这里根本跑不起来）。
#
# 由 scripts/install-hooks.mjs 通过 git config core.hooksPath 激活（与 pre-push 同一目录）。
cd "$(git rev-parse --show-toplevel)" || exit 1
exec node scripts/runGates.mjs --hook
